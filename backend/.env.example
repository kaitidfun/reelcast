# Security
SECRET_KEY=your_super_secret_key_here

# Encrypts SocialAccount access/refresh tokens at rest (Feature 3 — Multi-Platform
# Distribution). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Optional for local dev (falls back to a fixed dev-only key); set a real one
# anywhere tokens matter, since anyone with the code already has the dev key.
TOKEN_ENCRYPTION_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# Feature 3 — Multi-Platform Distribution "connect account" apps.
# Leave blank until each dev app is registered — the connect flow raises a
# clear "not configured yet" error instead of pretending to work.
#
# Redirect URI to register with each platform: {BACKEND_URL}/api/social/{platform}/callback
# BACKEND_URL defaults to http://localhost:8000, which only works for testing
# the YouTube connect flow — TikTok flatly rejects localhost/127.0.0.1 redirect
# URIs (requires public HTTPS), and Meta requires HTTPS even for localhost.
# To test any of the connect flows, run `ngrok http 8000` (free static domain,
# no signup card needed), then set BOTH of these to the same ngrok URL:
#   1. BACKEND_URL below (e.g. https://your-name.ngrok-free.app)
#   2. The redirect URI field in each platform's dev app settings
# Only needed while testing the "Connect Account" OAuth roundtrip — normal
# app usage (including publishing once connected) doesn't touch ngrok at all.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Feature 5 — Data Tracking
#
# Create/approve the seller and analytics permissions in each provider's
# developer console before setting these. Each SYNC_URL is a server-side
# provider adapter endpoint; it receives the encrypted account token only from
# the ReelCast backend and must return the normalized JSON contract documented
# in README.md. Never expose these keys with NEXT_PUBLIC_ or in the frontend.
TRACKING_SYNC_TIMEOUT_SECONDS=30
TRACKING_TIKTOK_SHOP_SYNC_URL=
TRACKING_TIKTOK_SHOP_ADAPTER_KEY=
TRACKING_TIKTOK_SHOP_AUTHORIZE_URL=
TRACKING_TIKTOK_SHOP_TOKEN_EXCHANGE_URL=
TRACKING_SHOPEE_SYNC_URL=
TRACKING_SHOPEE_ADAPTER_KEY=
TRACKING_SHOPEE_AUTHORIZE_URL=
TRACKING_SHOPEE_TOKEN_EXCHANGE_URL=
TRACKING_LAZADA_SYNC_URL=
TRACKING_LAZADA_ADAPTER_KEY=
TRACKING_LAZADA_AUTHORIZE_URL=
TRACKING_LAZADA_TOKEN_EXCHANGE_URL=
TRACKING_TIKTOK_SYNC_URL=
TRACKING_TIKTOK_ADAPTER_KEY=
TRACKING_YOUTUBE_SYNC_URL=
TRACKING_YOUTUBE_ADAPTER_KEY=
TRACKING_FACEBOOK_SYNC_URL=
TRACKING_FACEBOOK_ADAPTER_KEY=
TRACKING_INSTAGRAM_SYNC_URL=
TRACKING_INSTAGRAM_ADAPTER_KEY=

# SMTP (Email Verification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=  # Optional: e.g. https://cdn.yourdomain.com

# Google AI Studio — used by Gemini Flash (captions, prompts) in ai_service.py
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Google Cloud / Vertex AI — no longer used (pipeline migrated to AI Studio)
# Kept for reference only — can be removed once migration is confirmed working
GOOGLE_APPLICATION_CREDENTIALS=path_to_your_google_credentials.json
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=your_google_cloud_location

# fal.ai — video generation (cheap: ~฿0.5/video) — get key at fal.ai
FAL_KEY=your_fal_api_key

# Dev flag: set true to skip LTX and return Gemini 3 Pro Image first frame as video
# Use to test first frame generation without paying for LTX generation
# Set back to false (or remove) when ready for full pipeline
SKIP_LTX=false

# Local Database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# Use only for automated local system tests; suppresses email and AI provider calls.
REELCAST_TEST_MODE=false
