# ─────────────────────────────────────────────────────────
# ReelCast E2E Test Environment
# Copy this file to `.env.test` and fill in your values.
# ─────────────────────────────────────────────────────────

# Application URLs
FRONTEND_URL=your_frontend_url  # e.g. http://localhost:3000
BACKEND_URL=your_backend_url  # e.g. http://localhost:8000

# PostgreSQL connection (must match the backend's DATABASE_URL)
PG_HOST=your_pg_host
PG_PORT=your_pg_port
PG_DATABASE=your_pg_database
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password
