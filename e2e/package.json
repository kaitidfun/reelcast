{
  "name": "reelcast-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "ReelCast UI unit and system end-to-end tests",
  "scripts": {
    "test": "playwright test --grep-invert @external --workers=4 --retries=0",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui-unit": "playwright test --project=ui-unit --workers=4 --retries=0",
    "test:system": "playwright test --project=system --grep-invert @external --workers=4 --retries=0",
    "test:system:external": "playwright test --project=system --grep @external",
    "test:list": "playwright test --list --grep-invert @external",
    "test:ui-unit:stability": "playwright test --project=ui-unit --repeat-each=3 --workers=4 --retries=0",
    "test:system:stability": "playwright test --project=system --grep-invert @external --repeat-each=3 --workers=4 --retries=0",
    "test:stability": "npm run test:ui-unit:stability && npm run test:system:stability",
    "test:all": "playwright test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.14",
    "dotenv": "^16.5.0",
    "pg": "^8.16.0",
    "typescript": "^5.8.3"
  }
}
