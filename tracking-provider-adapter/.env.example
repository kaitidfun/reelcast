PORT=9000
REQUEST_TIMEOUT_SECONDS=15
SYNC_TIMEOUT_SECONDS=24
OPTIONAL_TIMEOUT_SECONDS=5
SYNC_CONCURRENCY=4
READ_ATTEMPTS=3

# ReelCast-to-adapter secrets: use a different long random value for each platform.
ADAPTER_KEY_TIKTOK=replace-with-long-random-secret
ADAPTER_KEY_YOUTUBE=replace-with-long-random-secret
ADAPTER_KEY_FACEBOOK=replace-with-long-random-secret
ADAPTER_KEY_INSTAGRAM=replace-with-long-random-secret

# Provider URLs. Keep them in the environment to allow regional/version changes without code changes.
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
YOUTUBE_API_BASE_URL=https://www.googleapis.com
YOUTUBE_ANALYTICS_API_BASE_URL=https://youtubeanalytics.googleapis.com
# Separate base URLs allow Facebook and Instagram to use independent Graph versions.
FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com/v23.0
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.instagram.com/v23.0
