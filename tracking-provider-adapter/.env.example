PORT=9000
REQUEST_TIMEOUT_SECONDS=15

# ReelCast-to-adapter secrets: use a different long random value for each platform.
ADAPTER_KEY_TIKTOK_SHOP=replace-with-long-random-secret
ADAPTER_KEY_SHOPEE=replace-with-long-random-secret
ADAPTER_KEY_LAZADA=replace-with-long-random-secret
ADAPTER_KEY_TIKTOK=replace-with-long-random-secret
ADAPTER_KEY_YOUTUBE=replace-with-long-random-secret
ADAPTER_KEY_FACEBOOK=replace-with-long-random-secret
ADAPTER_KEY_INSTAGRAM=replace-with-long-random-secret

# Shop provider credentials
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
SHOPEE_APP_KEY=
SHOPEE_APP_SECRET=
# Required by Shopee's token endpoint when the ReelCast callback does not pass shop_id.
SHOPEE_SHOP_ID=
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# Provider URLs. Keep them in the environment to allow regional/version changes without code changes.
TIKTOK_SHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_AUTHORIZE_URL=https://auth.tiktok-shops.com/oauth/authorize
TIKTOK_SHOP_TOKEN_URL=https://auth.tiktok-shops.com/api/v2/token/get
SHOPEE_API_BASE_URL=https://partner.shopeemobile.com
SHOPEE_AUTHORIZE_URL=https://partner.shopeemobile.com/api/v2/shop/auth_partner
# Select the documented regional seller API endpoint (replace .co.th if required).
LAZADA_API_BASE_URL=https://api.lazada.co.th/rest
LAZADA_AUTHORIZE_URL=https://auth.lazada.com/oauth/authorize
LAZADA_TOKEN_URL=https://auth.lazada.com/rest/auth/token/create
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
YOUTUBE_API_BASE_URL=https://www.googleapis.com
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v23.0
