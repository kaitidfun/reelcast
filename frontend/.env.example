# Default local API endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Set the public FRONTEND origin when deploying to enable search indexing.
# Leave unset for local development. Do not use the backend/API URL here.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional verification token from Google Search Console (HTML tag method).
# GOOGLE_SITE_VERIFICATION=

# Shop OAuth through ngrok (example — use your own reserved domain):
# NEXT_PUBLIC_OAUTH_API_URL=https://your-domain.ngrok-free.app/api
# This must use the same public domain as backend BACKEND_URL so the browser
# returns the OAuth session cookie to the callback endpoint. Keep
# NEXT_PUBLIC_API_URL local to avoid the free ngrok browser warning on normal
# API fetch requests. This OAuth URL is shared by Shop, Social Account, and
# Google/Facebook sign-in flows.
